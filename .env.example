# Servidor
PORT=8000

# Base de datos
POSTGRES_DB=identity
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://user:password@localhost:5432/scesi_identity

# Parámetros de seguridad para Argon2id (opcional)
# Si no se especifican, se usan los valores por defecto:
# - memoryCost: 65536 (64 MB)
# - timeCost: 3
# - parallelism: 2
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=2

# Seguridad JWT (obligatorio en producción)
# Secret con el que se firman los access tokens (HS256).
JWT_SECRET=change-me-to-a-long-random-string
# Cadencia del access token (formato de duración de ms, p.ej. "15m", "1h").
JWT_EXPIRES_IN=15m
# Vida útil del refresh token en días (para rotación de sesiones en DB).
REFRESH_TOKEN_TTL_DAYS=30
